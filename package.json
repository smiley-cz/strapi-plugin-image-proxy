{
  "name": "strapi-plugin-image-proxy",
  "version": "1.1.0",
  "description": "On-demand image processing and caching plugin for Strapi V5 using Sharp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smiley-cz/strapi-plugin-image-proxy.git"
  },
  "files": [
    "server",
    "README.md"
  ],
  "strapi": {
    "kind": "plugin",
    "name": "image-proxy",
    "displayName": "Image Proxy",
    "description": "On-demand image processing with Sharp, disk caching, and TTL support"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "source": "./server/src/index.js",
      "require": "./server/src/index.js",
      "default": "./server/src/index.js"
    }
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "sharp": "^0.34.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  }
}
